{
    "window.commandCenter": true,
    "workbench.colorTheme": "Material Theme High Contrast",
    "redhat.telemetry.enabled": true,
    "workbench.iconTheme": "material-icon-theme",
    "claudeCode.preferredLocation": "panel",
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js, ${capture}.typegen.ts",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts, ${capture}.typegen.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.mts": "${capture}.typegen.ts",
        "*.cts": "${capture}.typegen.ts"
    },
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "cSpell.userWords": ["Favs"],
    "editor.wordWrap": "on",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "makefile.configureOnOpen": true,
    "explorer.confirmDelete": false,
    "amp.url": "https://ampcode.com/",
    "editor.wordBasedSuggestions": "off",
    "amp.tab.enabled": true,
    "claudeCode.selectedModel": "default",
    "git.openRepositoryInParentFolders": "never",
    "git.blame.editorDecoration.enabled": true,
    "git.autorefresh": true,
    "git.autorefreshInterval": 30000,
    "explorer.confirmDragAndDrop": false,
    "gitlens.currentLine.enabled": false
}
