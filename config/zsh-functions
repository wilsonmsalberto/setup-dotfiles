# Git Utility Functions
# =============================================================================

# -----------------------------------------------------------------------------
# Change git committer for past commits
# Usage: git_changeCommitter
# Note: Uses git filter-branch (consider git-filter-repo for new projects)
# -----------------------------------------------------------------------------
git_changeCommitter() {
    echo "Please enter the old commiter name: "
    read old_committer_name

    echo "Please enter the new committer name: "
    read new_committer_name
    echo "Please enter the new committer email: "
    read new_committer_email

    git filter-branch --commit-filter '
        if [ "$GIT_COMMITTER_NAME" = "'"$old_committer_name"'" ];
        then
                GIT_COMMITTER_NAME="'"$new_committer_name"'";
                GIT_AUTHOR_NAME="'"$new_committer_name"'";
                GIT_COMMITTER_EMAIL="'"$new_committer_email"'";
                GIT_AUTHOR_EMAIL="'"$new_committer_email"'";
                git commit-tree "$@";
        else
                git commit-tree "$@";
        fi' HEAD
}

# -----------------------------------------------------------------------------
# Transfer one git repository into another
# Usage: git_transfer
# -----------------------------------------------------------------------------
git_transfer() {
    echo "Please enter the repository folder: "
    read repo_folder
    mkdir "$repo_folder"
    cd "$repo_folder"

    echo "Please enter the origin repository: "
    read src_repo

    echo "Please enter the target repository: "
    read target_repo

    git init --bare .git
    git remote add origin "$src_repo"
    git fetch --all
    git init
    git branch -r | grep -v '\->' | while read remote; do git branch --track "${remote#origin/}" "$remote"; done
    git pull --all
    git remote rm origin
    git remote add origin "$target_repo"
    git push --all origin
    git checkout master
}

