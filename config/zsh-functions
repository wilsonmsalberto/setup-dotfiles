# -----------------------------------------------------------------------------
# Find a specific folder inside any folder and delete it
# Usage: delete_folder
# -----------------------------------------------------------------------------
delete_folder() {
    echo "Please enter folder to delete: "
    read folder

    find . -name "$folder" -type d -prune -exec rm -rf '{}' +

    echo "Removal complete."
}

# -----------------------------------------------------------------------------
# Update all git repos inside a directory
# Usage: pull-all
# -----------------------------------------------------------------------------
pull-all() {
    for dir in $(ls -d */); do
        echo "Pulling ${dir}"
        cd ${dir}
        if [ -d ".git" ]; then
            git pull
        fi
        cd ..
    done
}

# =============================================================================
# Docker Functions
# =============================================================================

# -----------------------------------------------------------------------------
# Completely wipe everything Docker has. Very destructive.
# Usage: docker_hr
# -----------------------------------------------------------------------------
docker_hr() {
    echo ""
    echo "-----------------------------------"
    echo "Hard Docker reset. Proceed with caution."
    echo "-----------------------------------"
    echo ""

    read "?Are you sure (y/n)??" answer
    case ${answer:0:1} in
        y|Y )
            docker container stop $(docker container ls -aq)
            docker system prune --all --force --volumes
        ;;
        * )
            echo "Aborted"
        ;;
    esac
}

# -----------------------------------------------------------------------------
# Soft clean Docker containers
# Usage: docker_rmc
# -----------------------------------------------------------------------------
docker_rmc() {
    echo ""
    echo "-----------------------------------"
    echo "Stopping Containers"
    echo "-----------------------------------"
    echo ""

    docker container stop $(docker container ls -aq)

    echo ""
    echo "-----------------------------------"
    echo "Removing Containers"
    echo "-----------------------------------"
    echo ""

    docker container rm $(docker container ls -aq)

    echo ""
    echo "-----------------------------------"
    echo "All Containers were removed!"
    echo "-----------------------------------"
    echo ""
}

# -----------------------------------------------------------------------------
# Complete Docker info
# Usage: docker_info
# -----------------------------------------------------------------------------
docker_info() {
