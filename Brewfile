# =============================================================================
# Language Runtimes
# =============================================================================
# Uncomment as needed for your development stack

brew "ruby"                   # Ruby language
brew "openjdk@17"             # Java 17 (for React Native / Android)
brew "python@3.14"            # Python runtime

# =============================================================================
# React Native / Mobile Development
# =============================================================================

brew "watchman"               # File watcher (required by Metro bundler)
brew "mkcert"                 # Local HTTPS certificates

# =============================================================================
# Terminal Emulator
# =============================================================================

cask "iterm2"                 # Better terminal for macOS

# =============================================================================
# Fonts
# =============================================================================

cask "font-meslo-lg-nerd-font"  # Nerd Font for Powerlevel10k

# =============================================================================
# Code Editors
# =============================================================================

cask "cursor"                 # AI-powered code editor
# cask "visual-studio-code"   # Microsoft VS Code

# =============================================================================
# Menu Bar Utilities
# =============================================================================

cask "bartender"              # Menu bar organizer
cask "domzilla-caffeine"      # Prevent Mac from sleeping (auto-updates)
cask "meetingbar"             # Calendar meetings in menu bar
cask "notunes"                # Prevent iTunes/Music from opening

# =============================================================================
# Productivity
# =============================================================================

cask "raycast"                # Spotlight replacement
cask "rectangle"              # Window manager with keyboard shortcuts
cask "espanso"                # Text expander

