# =============================================================================
# Brewfile - Declarative Homebrew Dependencies
# =============================================================================
# Install with: brew bundle --file=Brewfile
# Check what's installed: brew bundle check
# Clean up unlisted: brew bundle cleanup
# =============================================================================


# =============================================================================
# Essential CLI Tools
# =============================================================================
# These are installed with both --minimal and --full flags

# Version control
brew "git"                    # Distributed version control system
brew "gh"                     # GitHub CLI

# Modern shell utilities
brew "eza"                    # Modern replacement for ls
brew "bat"                    # Cat clone with syntax highlighting
brew "ripgrep"                # Fast grep alternative (rg)
brew "fd"                     # Fast find alternative
brew "jq"                     # JSON processor
brew "zoxide"                 # Smarter cd command (z/autojump replacement)
brew "fzf"                    # Fuzzy finder for command line
brew "tealdeer"               # Simplified man pages (tldr)

# Git enhancement
brew "git-delta"              # Syntax-highlighting pager for git/diff

# Node.js
brew "fnm"                    # Fast Node Manager
brew "pnpm"                   # Fast, disk space efficient package manager

# Python
brew "uv"                     # Fast Python package manager

# Editor
brew "nano"                   # Simple text editor

# =============================================================================
# Optional CLI Tools
# =============================================================================
# These are installed with --full flag or when selected interactively

# brew "httpie"               # Modern HTTP client
