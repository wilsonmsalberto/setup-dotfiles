# =============================================================================
# Dotfiles Environment Configuration
# =============================================================================
# Copy this file to .env and customize with your own values:
#   cp .env.example .env
#   nano .env
#
# This file is NOT tracked in git (added to .gitignore)
# =============================================================================

# =============================================================================
# Git Configuration
# =============================================================================

# Your full name for Git commits
GIT_USER_NAME="Wilson Alberto"

# Default email for Git commits (leave empty to be prompted during install)
GIT_USER_EMAIL=""

# Work email (used by git-workuser function/alias)
GIT_WORK_EMAIL="wilson.alberto@olx.com"

# Personal email (used by git-homeuser function/alias)
GIT_HOME_EMAIL="wilsonalberto@gmail.com"

# =============================================================================
# Optional Customization
# =============================================================================

# Uncomment and set to override default editor
# DEFAULT_EDITOR="nano"

# Uncomment to set a custom dotfiles installation directory
# DOTFILES_DIR="$HOME/.dotfiles"

# Uncomment to set a custom backup directory
# BACKUP_DIR="$HOME/.dotfiles_backup"

# =============================================================================
# Feature Toggles
# =============================================================================
# Set to "false" to skip specific configuration modules

# INSTALL_CLAUDE_CODE=true
# INSTALL_CURSOR=true
# INSTALL_ITERM2=true
# INSTALL_EXTRAS=true
